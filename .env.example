# ============================================================================
# LabelBuddy AI 環境變數範本
# 使用方式：複製此檔為 .env 並填入實際值
#   cp .env.example .env
# ⚠️ 檔名必須是 .env。server.ts 使用 dotenv.config()，它預設只讀取 .env，
#    命名為 .env.local 等都不會被載入，金鑰會靜默失效。
#
# 【雙供應商輪替】
# 程式會依「今日使用率」在 Gemini 與 OpenRouter 之間輪替呼叫，
# 讓兩邊的免費額度平均消耗。只要設定其中一家即可運作。
# 任一家連續失敗會自動進入冷卻並被跳過。
# ============================================================================

# --- Google Gemini ---
# 申請位置：https://aistudio.google.com/apikey
# 免費額度：5 次/分、1500 次/日
# ⚠️ Gemini API 的官方支援區域不含中國澳門、中國香港、中國大陸。
#    從這些地區呼叫會得到：
#      400 FAILED_PRECONDITION: User location is not supported for the API use.
#    這是服務區域限制而非金鑰問題。程式會自動偵測並冷卻跳過，不影響另一家運作。
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# --- OpenRouter ---
# 申請位置：https://openrouter.ai/keys
# 免費層約 50 次/日（未儲值帳號）
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_BASE_URL: 選用。OpenRouter API 端點，一般不需修改。
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OPENROUTER_MODEL: 選用。留空則使用 server.ts 內建的免費模型優先序
# （inclusionai/ling-3.0-flash-vl:free → gemma-4-31b-it:free → qwen3.8-27b:free）。
# 若要改用付費模型，在此填入單一模型名稱即可。
OPENROUTER_MODEL=""

# --- 共用設定 ---
# APP_URL: 選用。本服務對外網址，會作為 OpenRouter 的 HTTP-Referer 標頭。
APP_URL="http://localhost:3000"

# AI_REQUEST_TIMEOUT_MS: 選用。單次 AI 請求逾時上限（毫秒），預設 45000。
# AI_REQUEST_TIMEOUT_MS="45000"

# AI_CACHE_TTL_MS: 選用。分析結果快取存活時間（毫秒），預設 24 小時。
# 同一張圖 + 同一組慢性病在期限內不重複呼叫 API，是節省免費額度最有效的手段。
# AI_CACHE_TTL_MS="86400000"

# PORT: 選用。伺服器監聽埠，預設 3000。
# PORT=3000
