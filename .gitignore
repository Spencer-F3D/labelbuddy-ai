node_modules/
build/
dist/
coverage/
.DS_Store
*.log
bun.lock
.env*
!.env.example

# 臨時檔案（除錯腳本、API 測試用的請求 body、commit message 草稿等）
# ⚠️ 用 .tmp- 開頭是本專案的約定；曾經不小心把 commit message 草稿提交進去過。
.tmp-*

# Cloudflare Workers 本機開發用的環境變數（含 API 金鑰）
# wrangler dev 會自動讀這個檔案；正式環境的金鑰用 `wrangler secret put` 設定。
.dev.vars
.wrangler/

# 驗證腳本的打包產物（npm run ocr:smoke / verify:conditions 會產生，用後即丟）
.ocr-smoke.mjs
.verify-conditions.mjs
.verify-dist/
# 驗證腳本的截圖輸出（verify-web-app.mjs 產生，每次目錄名可能不同）
shots*/

# tesseract.js 若未指定 cacheMethod 會把語言檔複製到工作目錄。
# 正式路徑已設 cacheMethod:'none'，這裡只是防止測試時不小心把 7.5 MB 的副本提交進去。
# ⚠️ 只錨定根目錄，不可寫成 *.traineddata（那會排除 public/tessdata/ 的正本）。
/chi_tra.traineddata
/eng.traineddata

# OCR 執行檔：由 scripts/copy-ocr-assets.mjs 從 node_modules 複製而來（約 12 MB）。
# 不進版控的理由：它們本來就是 npm 依賴的一部分，提交等於把第三方二進位檔
# 放進 git、且可能與 package.json 的版本不一致。用腳本在 dev/build 前複製即可。
# ⚠️ public/tessdata/*.traineddata 不在此列 —— 那兩個是我們自己的資產，必須提交。
public/tesseract-core/
public/tesseract-worker.min.js

# 比賽章程 PDF（2026-09-27 使用者指定不納入版控）。
# 用萬用字元而非完整檔名，這樣重新下載成「... (2).pdf」時也會被擋下。
# 檔案仍留在專案根目錄供查閱，只是不進 git。
2026全球青少年人工智能未來創新競賽*.pdf

# ── Capacitor / Android（2026-10-01 新增）──────────────────────────────
# android/ 這個原生專案本身**要進版控**（它是原始碼，不是產物），
# 但底下的建置產物與機器專屬設定不要。
android/.gradle/
android/.idea/
android/app/.cxx/
android/app/release/
android/app/debug/
# ⚠️ local.properties 是機器專屬的 SDK 路徑，別人的電腦路徑不同。
#    這是 Android 官方建議忽略的檔案。
android/local.properties
# 由 `npx cap sync` 從 dist/ 複製過來的網頁資產 —— 會重新產生，不進版控。
# （Android Studio 的預設 .gitignore 也是這樣處理）
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# 簽章檔：**絕對不可以進版控**（外洩等於任何人都能冒名發布你的 App）
*.jks
*.keystore
!android/app/debug.keystore
android/keystore.properties
